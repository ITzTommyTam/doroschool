<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <!-- 1. Background toàn màn hình -->
    <ImageView
        android:id="@id/background_image"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login_img" />

    <!-- 2. Logo Doro: Ghim cố định ở đỉnh, cách mép trên 85dp -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="85.0dip">

        <FrameLayout
            android:layout_width="135.0dip"
            android:layout_height="135.0dip"
            android:layout_gravity="center"
            android:background="@null">

            <FrameLayout
                android:layout_width="135.0dip"
                android:layout_height="135.0dip"
                android:layout_gravity="center"
                android:background="@null"
                android:padding="0.0dip">

                <ImageView
                    android:id="@id/imgLogo"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ico_vietschool_logo_transparent" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- 3. ScrollView đón nhận bàn phím, nâng vừa vặn, không trượt lố -->
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip">

            <!-- Khoảng trống co giãn: Bình thường đẩy cụm ô nhập xuống vừa vặn ngang áo/chân váy -->
            <Space
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />

            <!-- Các view ẩn giữ nguyên ID để tránh crash -->
            <TextView
                android:id="@id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Ô nhập tài khoản / SĐT -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="56.0dip"
                android:background="@drawable/bg_edittext"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12.0dip"
                android:paddingEnd="12.0dip">

                <ImageView
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:src="@drawable/person_24px"
                    android:tint="@color/login_foreground" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/tbSoDienThoai"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:background="@null"
                    android:backgroundTint="@null"
                    android:hint=""
                    android:maxLines="1"
                    android:padding="0.0dip"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/login_foreground"
                    android:textColorHint="#ff5c6783"
                    android:textSize="16.0sp" />

                <ImageView
                    android:id="@id/btRemoveSoDienThoai"
                    android:layout_width="30.0dip"
                    android:layout_height="fill_parent"
                    android:padding="4.0dip"
                    android:src="@drawable/cancel_24px"
                    android:tint="@color/login_foreground"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Khoảng cách giữa 2 ô: 12dp -->
            <Space
                android:layout_width="fill_parent"
                android:layout_height="12.0dip" />

            <!-- Ô nhập mật khẩu -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="56.0dip"
                android:background="@drawable/bg_edittext"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12.0dip"
                android:paddingEnd="12.0dip">

                <ImageView
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:src="@drawable/lock_24px"
                    android:tint="@color/login_foreground" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@id/tbMatKhau"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:background="@null"
                    android:backgroundTint="@null"
                    android:hint=""
                    android:inputType="textPassword"
                    android:padding="0.0dip"
                    android:selectAllOnFocus="true"
                    android:text=""
                    android:textColor="@color/login_foreground"
                    android:textColorHint="#ff5c6783"
                    android:textSize="16.0sp" />

                <ImageView
                    android:id="@id/btRemovePassword"
                    android:layout_width="30.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginEnd="10.0dip"
                    android:padding="4.0dip"
                    android:src="@drawable/cancel_24px"
                    android:tint="@color/login_foreground"
                    android:visibility="gone" />

                <ImageView
                    android:id="@id/btHidePass"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:src="@drawable/visibility_24px"
                    android:tint="@color/login_foreground"
                    android:visibility="gone" />

                <ImageView
                    android:id="@id/btViewPass"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:src="@drawable/visibility_off_24px"
                    android:tint="@color/login_foreground"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Quên mật khẩu ẩn -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@id/tbForgetPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Khoảng cách trước nút khóa: 16dp -->
            <Space
                android:layout_width="fill_parent"
                android:layout_height="16.0dip" />

            <!-- Nút ổ khóa tròn trắng đen -->
            <Button
                android:id="@id/btLogin"
                android:layout_width="60.0dip"
                android:layout_height="60.0dip"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_button_login"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:minWidth="0.0dip"
                android:minHeight="0.0dip"
                android:stateListAnimator="@null"
                android:text="" />

            <!-- Đăng ký ẩn -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@id/tvRegist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Đệm đáy 45dp: Lúc bình thường nâng cụm cao hơn đáy một chút, mở phím nâng vừa đủ -->
            <Space
                android:layout_width="fill_parent"
                android:layout_height="45.0dip" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
