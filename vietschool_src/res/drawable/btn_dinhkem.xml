<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true" android:drawable="@drawable/bg_process_dialog" />
    <item android:state_focused="true" android:state_enabled="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient android:startColor="#f2ffffff" android:endColor="#ffd5faff" android:angle="45.0" />
            <corners android:radius="10.0dip" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient android:startColor="#f2ffffff" android:endColor="#ffd5faff" android:angle="45.0" />
            <corners android:radius="10.0dip" />
        </shape>
    </item>
    <item android:state_enabled="false" android:drawable="@drawable/st_btn_disable" />
</selector>