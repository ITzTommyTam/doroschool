<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ffc7e6ff" android:endColor="#ffd2ebff" android:angle="90.0" android:centerColor="#ff80cdff" />
            <stroke android:width="1.0dip" android:color="#ffdcf0ff" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ffe0f2ff" android:endColor="#ffe7f3ff" android:angle="90.0" android:centerColor="#b1b0e9ff" />
            <stroke android:width="1.0dip" android:color="#ffbfe2ff" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ffe0f2ff" android:endColor="#ffe7f3ff" android:angle="90.0" android:centerColor="#b1b0e9ff" />
            <stroke android:width="1.0dip" android:color="#ffbfe2ff" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ffc8c8c8" android:endColor="@color/lightgrey" android:angle="90.0" android:centerColor="#ffe4e4e4" />
            <stroke android:width="1.0dip" android:color="#14000000" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ffc8c8c8" android:endColor="@color/lightgrey" android:angle="90.0" android:centerColor="#ffe4e4e4" />
            <stroke android:width="1.0dip" android:color="#14000000" />
        </shape>
    </item>
</selector>