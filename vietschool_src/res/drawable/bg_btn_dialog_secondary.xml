<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ffe2e8f0" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#fff8fafc" />
            <corners android:radius="14.0dip" />
            <stroke android:width="1.0dip" android:color="#ffcbd5e1" />
        </shape>
    </item>
</selector>