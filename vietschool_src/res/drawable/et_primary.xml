<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient android:startColor="#ffffffff" android:endColor="#ffffffff" android:angle="45.0" />
            <corners android:topLeftRadius="@dimen/et_radius" android:topRightRadius="@dimen/et_radius" android:bottomLeftRadius="@dimen/et_radius" android:bottomRightRadius="@dimen/et_radius" />
            <stroke android:width="1.0dip" android:color="@color/gray_400" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient android:startColor="#ffffffff" android:endColor="#ffffffff" android:angle="45.0" />
            <corners android:topLeftRadius="@dimen/et_radius" android:topRightRadius="@dimen/et_radius" android:bottomLeftRadius="@dimen/et_radius" android:bottomRightRadius="@dimen/et_radius" />
            <stroke android:width="1.0dip" android:color="@color/c_color2" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient android:startColor="#ffffffff" android:endColor="#ffffffff" android:angle="45.0" />
            <corners android:topLeftRadius="@dimen/et_radius" android:topRightRadius="@dimen/et_radius" android:bottomLeftRadius="@dimen/et_radius" android:bottomRightRadius="@dimen/et_radius" />
            <stroke android:width="1.0dip" android:color="@color/gray_400" />
        </shape>
    </item>
    <item android:state_enabled="false" android:drawable="@drawable/st_btn_disable" />
</selector>